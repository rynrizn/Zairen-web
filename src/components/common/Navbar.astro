---
import { siteConfig } from '../../config/site';
import { CartBadge } from './CartBadge';
import { FavoritesBadge } from './FavoritesBadge';
import { ShareButton } from './ShareButton';
import { ThemeToggle } from './ThemeToggle';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
---

<!-- Header Superior Flotante Minimalista -->
<header class="navbar-header fixed top-2 sm:top-3 left-2 sm:left-4 right-2 sm:right-4 z-40 max-w-7xl mx-auto bg-[#0A0A0A]/90 backdrop-blur-md border border-[#201f1f] shadow-2xl transition-all rounded-none">
  <!-- Barra Promocional Superior Fija (Si está activa en Supabase / LocalStorage) -->
  <div
    id="top-promo-banner"
    style="display: none;"
    class="w-full bg-[#141416] text-[#FAF9F6] border-b border-[#dc143c]/40 text-center py-1.5 px-4 font-mono text-[11px] uppercase tracking-wider relative z-50 flex items-center justify-center gap-3 transition-colors"
  >
    <span class="w-1.5 h-1.5 rounded-none bg-[#dc143c] animate-pulse shrink-0"></span>
    <a id="top-promo-banner-link" href="#catalogo" class="hover:text-[#dc143c] transition-colors truncate">
      <span id="top-promo-banner-text">NUEVO DROP 2026 // ENVÍOS A TODA BOLIVIA</span>
    </a>
  </div>
  <div class="h-16 w-full max-w-[1440px] mx-auto px-4 md:px-8 flex items-center justify-between">
    
    <!-- Logotipo Oficial Suelto & Limpio (Sin cajas ni marcos que lo encierren) -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="https://res.cloudinary.com/ds4qnoypm/image/upload/v1791690155/zairen_logo_oficial_nehjev.webp"
        alt="Zairen Lab Logo Oficial"
        class="w-9 h-9 object-contain p-0.5 transition-transform duration-300 group-hover:scale-105"
      />
      <span class="navbar-logo-text font-display text-base md:text-lg font-extrabold text-[#FAF9F6] tracking-widest uppercase transition-colors">
        {siteConfig.name}
      </span>
    </a>

    <!-- Enlaces Centrales (Desktop) - Catálogo y Contacto -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/"
        class={`navbar-link text-xs font-mono uppercase tracking-widest transition-colors ${
          activePath === '/' || activePath === '/catalogo'
            ? 'text-[#FAF9F6] font-bold border-b-2 border-[#dc143c] pb-1'
            : 'text-[#8F8F8C] hover:text-[#FAF9F6]'
        }`}
      >
        Catálogo
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number}`}
        target="_blank"
        rel="noopener noreferrer"
        class="navbar-link text-xs font-mono uppercase tracking-widest text-[#8F8F8C] hover:text-[#FAF9F6] transition-colors flex items-center gap-1.5"
      >
        <span class="w-1.5 h-1.5 rounded-none bg-emerald-400"></span>
        <span>Contacto</span>
      </a>
    </nav>

    <!-- Acciones Derecha (Tema, Compartir, Favoritos, Carrito, Menú Hamburguesa Móvil) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Selector Modo Claro / Modo Oscuro -->
      <ThemeToggle client:load />

      <!-- Botón Compartir QR Ortogonal -->
      <ShareButton
        client:load
        className="w-9 h-9 bg-[#141416] hover:bg-[#201f1f] text-[#FAF9F6] border border-[#2A2A2A] rounded-none"
      />

      <!-- Acceso Rápido a Favoritos -->
      <FavoritesBadge client:load />

      <!-- Carrito Drawer Toggle -->
      <CartBadge client:load />
    </div>

  </div>
</header>

<style>
  :global(html.light) #top-promo-banner {
    background-color: #FAF9F6 !important;
    border-color: rgba(220, 20, 60, 0.3) !important;
    color: #141416 !important;
  }
  :global(body.has-promo-banner) main {
    padding-top: 6.5rem !important;
  }
  :global(html.light) .navbar-header {
    background-color: rgba(248, 247, 244, 0.95) !important;
    border-color: #DCD9D2 !important;
  }
  :global(html.light) .navbar-logo-text {
    color: #141416 !important;
  }
  :global(html.light) .navbar-link {
    color: #555558 !important;
  }
  :global(html.light) .navbar-link:hover {
    color: #141416 !important;
  }
  :global(html.light) #mobile-top-menu {
    background-color: rgba(255, 255, 255, 0.98) !important;
    border-color: #DCD9D2 !important;
  }
  :global(html.light) .mobile-nav-link {
    color: #141416 !important;
  }
  :global(html.light) #mobile-menu-toggle-btn {
    background-color: #FFFFFF !important;
    border-color: #DCD9D2 !important;
    color: #141416 !important;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  async function syncTopPromoBanner() {
    try {
      const banner = document.getElementById('top-promo-banner');
      const bannerText = document.getElementById('top-promo-banner-text');
      const bannerLink = document.getElementById('top-promo-banner-link') as HTMLAnchorElement;
      if (!banner || !bannerText) return;

      // 1. Render inmediato desde localStorage si existe
      const localEnabled = localStorage.getItem('zairen_banner_enabled') === 'true';
      const localText = localStorage.getItem('zairen_banner_text');
      const localLink = localStorage.getItem('zairen_banner_link');

      if (localEnabled && localText && localText.trim()) {
        banner.style.display = 'flex';
        bannerText.textContent = localText;
        if (bannerLink && localLink) bannerLink.href = localLink;
        document.body.classList.add('has-promo-banner');
      }

      // 2. Consulta y sincronización con Supabase
      const { data } = await supabase
        .from('configuracion')
        .select('apariencia')
        .eq('id', 1)
        .maybeSingle();

      if (data?.apariencia?.banner_promocional) {
        const bp = data.apariencia.banner_promocional;
        if (bp.activo && bp.texto && bp.texto.trim()) {
          banner.style.display = 'flex';
          bannerText.textContent = bp.texto;
          if (bannerLink && bp.link) bannerLink.href = bp.link;
          document.body.classList.add('has-promo-banner');
        } else {
          banner.style.display = 'none';
          document.body.classList.remove('has-promo-banner');
        }
      }
    } catch (e) {}
  }

  if (typeof window !== 'undefined') {
    syncTopPromoBanner();
    window.addEventListener('zairen-config-updated', syncTopPromoBanner);
  }
</script>
