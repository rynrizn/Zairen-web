---
import { siteConfig } from '../../config/site';
import { CartBadge } from './CartBadge';
import { ShareButton } from './ShareButton';
import { ThemeToggle } from './ThemeToggle';
import { BottomNavMobile } from './BottomNavMobile';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
---

<!-- Header Superior Fijo Minimalista -->
<header class="fixed top-0 left-0 right-0 z-40 bg-[#0A0A0A]/95 backdrop-blur-md border-b border-[#1C1B1B] transition-colors">
  <div class="h-16 w-full max-w-[1440px] mx-auto px-4 md:px-8 flex items-center justify-between">
    
    <!-- Logotipo Oficial Suelto & Limpio (Sin cajas ni bordes que lo encierren) -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/brand/zairen_logo_oficial.svg"
        alt="Zairen Lab Logo Oficial"
        class="w-8 h-8 object-contain transition-transform duration-300 group-hover:scale-105"
      />
      <span class="font-display text-base md:text-lg font-extrabold text-[#FAF9F6] tracking-widest uppercase transition-colors">
        {siteConfig.name}
      </span>
    </a>

    <!-- Enlaces Centrales (Desktop) -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/"
        class={`text-xs font-mono uppercase tracking-widest transition-colors ${
          activePath === '/' || activePath === '/catalogo'
            ? 'text-[#FAF9F6] font-bold border-b-2 border-[#dc143c] pb-1'
            : 'text-[#8F8F8C] hover:text-[#FAF9F6]'
        }`}
      >
        Catálogo
      </a>
      <a
        href="/marca"
        class={`text-xs font-mono uppercase tracking-widest transition-colors ${
          activePath === '/marca'
            ? 'text-[#FAF9F6] font-bold border-b-2 border-[#dc143c] pb-1'
            : 'text-[#8F8F8C] hover:text-[#FAF9F6]'
        }`}
      >
        Marca & Drops
      </a>
      <a
        href="/marca#contacto"
        class="text-xs font-mono uppercase tracking-widest text-[#8F8F8C] hover:text-[#FAF9F6] transition-colors"
      >
        Contacto
      </a>
    </nav>

    <!-- Acciones Derecha (Tema, Compartir, WhatsApp, Carrito) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Selector Modo Claro / Modo Oscuro -->
      <ThemeToggle client:load />

      <!-- Botón Compartir QR -->
      <ShareButton
        client:load
        className="w-9 h-9 bg-[#141416] hover:bg-[#201f1f] text-[#FAF9F6] border border-[#2A2A2A] rounded-none"
      />

      <!-- WhatsApp Directo -->
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Contactar Asesor WhatsApp"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 bg-[#141416] hover:bg-[#201f1f] text-[#FAF9F6] border border-[#2A2A2A] text-xs font-mono tracking-wider transition-colors"
      >
        <span class="w-1.5 h-1.5 bg-emerald-400"></span>
        <span>WhatsApp</span>
      </a>

      <!-- Carrito Drawer Toggle -->
      <CartBadge client:load />
    </div>

  </div>
</header>

<!-- Navegación Inferior Flotante Móvil -->
<BottomNavMobile client:load />
