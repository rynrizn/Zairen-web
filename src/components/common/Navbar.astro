---
import { siteConfig } from '../../config/site';
import { CartBadge } from './CartBadge';
---

<header class="fixed top-0 left-0 right-0 z-40 py-3 px-4 md:px-8 pointer-events-none">
  <div class="h-16 w-full max-w-[1440px] mx-auto px-4 md:px-6 flex items-center justify-between rounded-full bg-[#1c1b1b]/80 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.6)] border border-white/[0.08] pointer-events-auto">
    <!-- Logotipo y Marca -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-[#0e0e0e] border border-white/[0.08] flex items-center justify-center text-[#dc143c] shadow-[0_0_12px_rgba(220,20,60,0.25)] group-hover:border-[#dc143c]/50 transition-colors">
        <!-- Torii Minimalista SVG -->
        <svg class="w-5 h-5" viewBox="0 0 64 64" fill="none">
          <path d="M14 20H50M20 20V48M44 20V48M14 28H50M24 38H40" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-display text-sm md:text-base font-bold text-[#e5e2e1] tracking-wider uppercase group-hover:text-white transition-colors">
          {siteConfig.name}
        </span>
        <span class="font-code text-[9px] text-[#ffb3b3] uppercase tracking-widest leading-none">
          ザイレン 研究 // 2026
        </span>
      </div>
    </a>

    <!-- Enlaces Centrales (Desktop) -->
    <nav class="hidden lg:flex items-center gap-1 bg-[#0e0e0e]/50 p-1.5 rounded-full border border-white/[0.04]">
      <a
        href="/#catalogo"
        class="px-4 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider text-[#e5e2e1] hover:text-white hover:bg-white/[0.06] transition-colors"
      >
        Catálogo
      </a>
      <a
        href="/#lookbook"
        class="px-4 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider text-[#e6bdbc] hover:text-white hover:bg-white/[0.06] transition-colors"
      >
        Lookbook 01
      </a>
      <a
        href="/#especificaciones"
        class="px-4 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider text-[#e6bdbc] hover:text-white hover:bg-white/[0.06] transition-colors"
      >
        Textil & Specs
      </a>
    </nav>

    <!-- Acciones Derecha (Buscador, WhatsApp Concierge, Carrito) -->
    <div class="flex items-center gap-2.5">
      <!-- Botón WhatsApp Concierge -->
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Contactar Concierge WhatsApp"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#201f1f] hover:bg-[#2a2a2a] text-[#e5e2e1] hover:text-white border border-white/[0.08] text-xs font-mono tracking-wider transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>WhatsApp</span>
      </a>

      <!-- Carrito Drawer Toggle (Isla React) -->
      <CartBadge client:load />
    </div>
  </div>
</header>
