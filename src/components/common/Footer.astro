---
import { siteConfig, getActiveSocialNetworks } from '../../config/site';

const activeSocials = getActiveSocialNetworks();
---

<footer class="relative z-10 w-full bg-[#0e0e0e] border-t border-white/[0.06] pt-16 pb-12 mt-auto">
  <div class="max-w-[1440px] mx-auto px-4 md:px-12">
    <!-- Grid Principal de Footer -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">
      <!-- Columna 1 & 2: Identidad de Marca -->
      <div class="md:col-span-2 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#201f1f] border border-white/[0.08] flex items-center justify-center text-[#dc143c]">
            <svg class="w-4 h-4" viewBox="0 0 64 64" fill="none">
              <path d="M14 20H50M20 20V48M44 20V48M14 28H50M24 38H40" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-display text-lg font-bold text-[#e5e2e1] tracking-wider uppercase">
            {siteConfig.name}
          </span>
          <span class="font-code text-[10px] text-[#dc143c] bg-[#dc143c]/15 px-2 py-0.5 rounded-full uppercase tracking-wider">
            SHIBUYA & BOLIVIA
          </span>
        </div>

        <p class="text-[#ac8888] font-body text-sm max-w-md leading-relaxed">
          {siteConfig.description}
        </p>

        <span class="font-code text-xs text-[#5c3f3f]">
          無断転載を禁じます。制限付きドロップアーキテクチャ。
        </span>
      </div>

      <!-- Columna 3: Atención y Concierge -->
      <div class="flex flex-col gap-3">
        <span class="font-code text-xs text-[#e5e2e1] uppercase tracking-wider font-bold">
          Línea Directa Concierge
        </span>
        <a
          href={`https://wa.me/${siteConfig.whatsapp.number}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#1c1b1b] hover:bg-[#201f1f] text-[#e5e2e1] px-4 py-2 rounded-full border border-white/[0.06] text-xs font-mono transition-all w-fit group"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:shadow-[0_0_8px_#34d399] transition-all"></span>
          <span>WhatsApp ({siteConfig.whatsapp.displayNumber})</span>
        </a>
        <span class="font-code text-[11px] text-[#ac8888]">
          Despacho express a todo el país (24 a 48 hrs)
        </span>
      </div>

      <!-- Columna 4: Redes Sociales Dinámicas -->
      <div class="flex flex-col gap-3">
        <span class="font-code text-xs text-[#e5e2e1] uppercase tracking-wider font-bold">
          Redes Oficiales
        </span>
        {activeSocials.length > 0 ? (
          <div class="flex flex-col gap-2">
            {activeSocials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-mono text-[#ac8888] hover:text-[#e5e2e1] transition-colors"
              >
                <span class="text-[#dc143c]">▶</span>
                <span>{social.name}</span>
              </a>
            ))}
          </div>
        ) : (
          <span class="text-xs font-mono text-[#ac8888]">
            Canal principal: WhatsApp
          </span>
        )}
        <div class="flex items-center gap-2 pt-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="font-code text-[10px] text-[#ac8888] uppercase">NODE ONLINE // 2026-v2</span>
        </div>
      </div>
    </div>

    <!-- Barra Inferior de Copyright y Legales -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-8 border-t border-white/[0.06] gap-4 text-xs font-mono text-[#ac8888]">
      <span>© 2026 {siteConfig.name}. Confección experimental. Todos los derechos reservados.</span>
      <div class="flex items-center gap-6">
        <a href="/login" class="hover:text-[#e5e2e1] transition-colors">Admin Core</a>
        <a href="#catalogo" class="hover:text-[#e5e2e1] transition-colors">Políticas de Envío</a>
      </div>
    </div>
  </div>
</footer>
