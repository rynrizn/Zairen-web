---
import { siteConfig, getActiveSocialNetworks } from '../../config/site';

const activeSocials = getActiveSocialNetworks();
---

<footer class="relative z-10 w-full bg-[#0A0A0A] border-t border-[#1C1B1B] pt-16 pb-12 mt-auto transition-colors">
  <div class="max-w-[1440px] mx-auto px-4 md:px-8">
    
    <!-- Fila Superior: Marca Limpia & Formulario Newsletter 'Signals' -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-12 border-b border-[#1C1B1B]">
      
      <!-- Bloque de Marca (Sin cajas ni bordes que encierren el logo) -->
      <div class="lg:col-span-6 space-y-4">
        <a href="/" class="flex items-center gap-3 group w-fit">
          <img
            src="/brand/zairen_logo_oficial.svg"
            alt="Zairen Lab"
            class="w-8 h-8 object-contain transition-transform group-hover:scale-105"
          />
          <span class="font-display text-2xl font-extrabold uppercase tracking-widest text-[#FAF9F6]">
            {siteConfig.name}
          </span>
        </a>
        <p class="font-mono text-xs text-[#8F8F8C] uppercase tracking-widest">
          EVOLUCIÓN CONSTANTE // IDENTIDAD PROPIA // NO DEFAULT.
        </p>
        <p class="font-body text-sm text-[#8F8F8C] max-w-md leading-relaxed pt-1">
          Indumentaria experimental streetwear fusionando minimalismo japonés, cortes oversized pesados y siluetas de identidad en reposo. Tienda oficial online.
        </p>
      </div>

      <!-- Módulo Newsletter "Únete al Archivo" -->
      <div class="lg:col-span-6 flex flex-col justify-end space-y-3">
        <span class="text-xs font-mono text-[#FAF9F6] uppercase tracking-wider font-bold">
          ÚNETE AL ARCHIVO // SEÑALES DE DROP
        </span>
        <form 
          onsubmit="event.preventDefault(); alert('Gracias por unirte a las señales de Zairen Lab.');"
          class="flex items-stretch max-w-md w-full"
        >
          <input
            type="email"
            placeholder="Introduce tu correo electrónico..."
            required
            class="flex-1 bg-[#141416] border border-[#2A2A2A] focus:border-[#dc143c] text-[#FAF9F6] px-4 py-3 text-xs font-mono placeholder:text-[#4A4A4A] outline-none transition-colors"
          />
          <button
            type="submit"
            title="Suscribirse a lanzamientos"
            class="px-5 bg-[#FAF9F6] hover:bg-[#dc143c] text-[#0A0A0A] hover:text-white font-bold text-sm transition-colors border border-[#FAF9F6] hover:border-[#dc143c] flex items-center justify-center cursor-pointer"
          >
            →
          </button>
        </form>
        <span class="text-[11px] font-mono text-[#4A4A4A]">
          Acceso prioritario a tirajes limitados de 280-420 GSM. Cero spam.
        </span>
      </div>

    </div>

    <!-- Fila Media: Columnas Profesionales & Acceso Administrativo -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 py-10 text-xs font-mono">
      
      <!-- Columna 1: Explorar Catálogo -->
      <div class="space-y-3">
        <span class="text-[#FAF9F6] uppercase font-bold tracking-widest block">
          CATÁLOGO
        </span>
        <ul class="space-y-2 text-[#8F8F8C]">
          <li><a href="/" class="hover:text-[#FAF9F6] transition-colors">Todas las Prendas</a></li>
          <li><a href="/?col=drop-01" class="hover:text-[#FAF9F6] transition-colors">DROP 01</a></li>
          <li><a href="/?col=basicos" class="hover:text-[#FAF9F6] transition-colors">Línea Básicos</a></li>
          <li><a href="/?col=mecha-tech" class="hover:text-[#FAF9F6] transition-colors">Mecha Tech</a></li>
        </ul>
      </div>

      <!-- Columna 2: Identidad de Marca -->
      <div class="space-y-3">
        <span class="text-[#FAF9F6] uppercase font-bold tracking-widest block">
          MARCA
        </span>
        <ul class="space-y-2 text-[#8F8F8C]">
          <li><a href="/marca" class="hover:text-[#FAF9F6] transition-colors">Manifiesto</a></li>
          <li><a href="/marca#lineas" class="hover:text-[#FAF9F6] transition-colors">Líneas de Diseño</a></li>
          <li><a href="/marca#especificaciones" class="hover:text-[#FAF9F6] transition-colors">Calidad 280-420 GSM</a></li>
          <li><a href="/marca#contacto" class="hover:text-[#FAF9F6] transition-colors">Cotización & Pedidos</a></li>
        </ul>
      </div>

      <!-- Columna 3: Canales Oficiales -->
      <div class="space-y-3">
        <span class="text-[#FAF9F6] uppercase font-bold tracking-widest block">
          CANALES
        </span>
        <ul class="space-y-2 text-[#8F8F8C]">
          {activeSocials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-[#FAF9F6] transition-colors flex items-center gap-1.5">
                <span>{s.name}</span>
                <span class="text-[10px] text-[#4A4A4A]">↗</span>
              </a>
            </li>
          ))}
          <li>
            <a 
              href={`https://wa.me/${siteConfig.whatsapp.number}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-emerald-400 hover:underline flex items-center gap-1"
            >
              <span>WhatsApp Directo</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Gestión & Acceso Administrativo (Donde siempre estaba) -->
      <div class="space-y-3">
        <span class="text-[#FAF9F6] uppercase font-bold tracking-widest block">
          SISTEMA
        </span>
        <ul class="space-y-2 text-[#8F8F8C]">
          <li>
            <a href="/login" class="text-[#8F8F8C] hover:text-[#FAF9F6] transition-colors flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-[#dc143c] rounded-full"></span>
              <span>Acceso Admin // Core</span>
            </a>
          </li>
          <li><span class="text-[#4A4A4A]">ZRN-OS v2.6 Online</span></li>
          <li><span class="text-[#4A4A4A]">Tokyo Streetwear Core</span></li>
        </ul>
      </div>

    </div>

    <!-- Fila Inferior: Copyright & Créditos -->
    <div class="pt-8 border-t border-[#1C1B1B] flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-[#8F8F8C]">
      <span>© 2026 {siteConfig.name}. Todos los derechos reservados. Tienda Oficial Online.</span>
      <div class="flex items-center gap-6">
        <span>ESTRUCTURA SIN SATURACIÓN</span>
        <span class="w-1.5 h-1.5 bg-emerald-400"></span>
        <span>DROP 01 DISPONIBLE</span>
      </div>
    </div>

  </div>
</footer>
