---
import { siteConfig } from '../../config/site';
---

<div
  id="splash-loader"
  class="fixed inset-0 z-50 bg-[#0A0A0A] text-[#FAF9F6] flex flex-col items-center justify-center p-6 transition-opacity duration-300 pointer-events-none opacity-0"
  style="display: none;"
>
  <!-- Halo sutil de fondo -->
  <div class="fixed inset-0 pointer-events-none -z-10 flex items-center justify-center overflow-hidden">
    <div class="w-[360px] h-[360px] rounded-full bg-[#dc143c] blur-[140px] opacity-20"></div>
  </div>

  <div class="w-full max-w-xs flex flex-col items-center text-center space-y-6">
    <!-- Logotipo Oficial Vectorial Limpio (Sin cajas ni marcos alrededor) -->
    <div class="w-20 h-20 sm:w-24 sm:h-24 flex items-center justify-center animate-fade-in">
      <img
        src="https://res.cloudinary.com/ds4qnoypm/image/upload/v1791690155/zairen_logo_oficial_nehjev.webp"
        alt="Zairen Lab Logo Oficial"
        class="w-full h-full object-contain filter drop-shadow-[0_0_20px_rgba(220,20,60,0.4)]"
      />
    </div>

    <!-- Barra de Progreso Minimalista -->
    <div class="w-full space-y-2 pt-2">
      <div class="relative w-full h-[2px] bg-white/10 rounded-full overflow-hidden">
        <div id="splash-bar" class="absolute top-0 left-0 bottom-0 bg-[#dc143c] rounded-full w-0 transition-all duration-300 ease-out shadow-[0_0_8px_rgba(220,20,60,0.8)]"></div>
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono text-[#8F8F8C] tracking-widest">
        <span>CARGANDO</span>
        <span id="splash-percent">0%</span>
      </div>
    </div>
  </div>
</div>

<!-- Script Inline Inmediato con data-astro-rerun: Solo muestra si es primera visita -->
<script is:inline data-astro-rerun>
  (function () {
    try {
      if (typeof window !== 'undefined' && typeof sessionStorage !== 'undefined') {
        var seen = sessionStorage.getItem('zairen_splash_seen');
        var el = document.getElementById('splash-loader');
        if (!seen && el) {
          el.style.display = 'flex';
          el.style.opacity = '1';
          el.style.pointerEvents = 'auto';
        }
      }
    } catch (e) {}
  })();
</script>

<script>
  function dismissLoader() {
    const loader = document.getElementById('splash-loader');
    if (!loader) return;
    loader.style.opacity = '0';
    loader.style.pointerEvents = 'none';
    setTimeout(() => {
      loader.style.display = 'none';
    }, 300);
    try {
      sessionStorage.setItem('zairen_splash_seen', 'true');
    } catch (e) {}
  }

  function runSplashLogic() {
    const loader = document.getElementById('splash-loader');
    const bar = document.getElementById('splash-bar');
    const percent = document.getElementById('splash-percent');

    if (!loader) return;

    if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('zairen_splash_seen')) {
      loader.style.display = 'none';
      loader.style.opacity = '0';
      loader.style.pointerEvents = 'none';
      return;
    }

    let p = 30;
    if (bar && percent) {
      bar.style.width = '30%';
      percent.textContent = '30%';

      const interval = setInterval(() => {
        p += Math.floor(Math.random() * 25) + 25;
        if (p >= 100) {
          p = 100;
          bar.style.width = '100%';
          percent.textContent = '100%';
          clearInterval(interval);
          setTimeout(dismissLoader, 150);
        } else {
          bar.style.width = `${p}%`;
          percent.textContent = `${p}%`;
        }
      }, 80);

      // Timeout de seguridad absoluta: nunca bloquear más de 900ms
      setTimeout(() => {
        clearInterval(interval);
        dismissLoader();
      }, 900);
    } else {
      dismissLoader();
    }
  }

  // Ejecución inicial y en transiciones de página
  runSplashLogic();
  document.addEventListener('astro:page-load', runSplashLogic);
  document.addEventListener('astro:before-swap', () => {
    const loader = document.getElementById('splash-loader');
    if (loader) {
      loader.style.display = 'none';
      loader.style.opacity = '0';
      loader.style.pointerEvents = 'none';
    }
  });
</script>
