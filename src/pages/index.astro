---
import Layout from '../layouts/Layout.astro';
import { siteConfig, getActiveSocialNetworks } from '../config/site';

const activeSocials = getActiveSocialNetworks();
---

<Layout title={`${siteConfig.name} // Neo-Tokyo Zen Streetwear`}>
  <main class="flex-1 flex flex-col items-center justify-center min-h-screen px-6 py-12 relative overflow-hidden text-center">
    <!-- Luces volumétricas carmesí de fondo -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#dc143c]/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 right-10 w-80 h-80 bg-[#de0541]/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>

    <!-- Badge Protocol -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#201f1f] border border-white/[0.08] text-xs font-mono text-[#ffb3b3] uppercase tracking-widest mb-6">
      <span class="w-2 h-2 rounded-full bg-[#dc143c] animate-pulse shadow-[0_0_8px_#dc143c]"></span>
      <span>ZRN // PROTOCOL 2026 ACTIVE</span>
    </div>

    <!-- Título Principal -->
    <h1 class="text-4xl md:text-6xl font-bold font-display uppercase tracking-tight text-[#e5e2e1] max-w-3xl leading-tight mb-4">
      {siteConfig.name}
      <span class="block text-xl md:text-2xl font-normal text-[#dc143c] tracking-widest mt-2 font-mono">
        // {siteConfig.slogan}
      </span>
    </h1>

    <p class="text-[#ac8888] text-base md:text-lg max-w-xl mb-8 font-body leading-relaxed">
      {siteConfig.description}
    </p>

    <!-- Botones de Acción -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
      <a
        href="/#catalogo"
        class="px-8 py-3.5 rounded-full bg-[#dc143c] hover:bg-[#ff2d55] text-white text-sm font-mono uppercase tracking-wider font-bold shadow-[0_4px_24px_rgba(220,20,60,0.4)] transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      >
        Explorar Catálogo
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3.5 rounded-full bg-[#201f1f] hover:bg-[#2a2a2a] text-[#e5e2e1] border border-white/[0.1] text-sm font-mono uppercase tracking-wider transition-all flex items-center gap-2"
      >
        <span>WhatsApp</span>
        <span class="text-[#ffb3b3] text-xs font-mono">({siteConfig.whatsapp.displayNumber})</span>
      </a>
    </div>

    <!-- Redes Sociales Dinámicas -->
    {activeSocials.length > 0 && (
      <div class="flex items-center gap-4 pt-6 border-t border-white/[0.06]">
        <span class="text-xs font-mono text-[#ac8888] uppercase tracking-wider">Redes Oficiales:</span>
        <div class="flex items-center gap-3">
          {activeSocials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 rounded-full bg-[#201f1f]/80 hover:bg-[#dc143c] text-xs font-mono text-[#e5e2e1] hover:text-white transition-colors border border-white/[0.05]"
            >
              {social.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>
