---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SplashLoader from '../components/common/SplashLoader.astro';
import { WhatsAppContactModule } from '../components/common/WhatsAppContactModule';
import { CarritoDrawer } from '../components/catalogo/CarritoDrawer';
import { siteConfig } from '../config/site';
---

<Layout title={`${siteConfig.name} // ${siteConfig.slogan}`}>
  <!-- Splash Ambiental Inicial -->
  <SplashLoader />

  <!-- Navbar Glassmorphic Fijo -->
  <Navbar activePath="/" />

  <main class="min-h-screen">
    <!-- 1. HERO SECTION BRAND // MANIFIESTO Y PRESENTACIÓN -->
    <section class="relative min-h-[95vh] flex items-center justify-center pt-28 pb-16 px-4 md:px-12 overflow-hidden">
      <!-- Luces Volumétricas Carmesí & Obsidiana -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[750px] h-[750px] bg-[#dc143c]/15 rounded-full blur-[180px] pointer-events-none -z-10"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-[#93000a]/15 rounded-full blur-[160px] pointer-events-none -z-10"></div>

      <div class="w-full max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Contenido Principal Hero (7 cols) -->
        <div class="lg:col-span-7 flex flex-col items-start text-left z-10 space-y-6">
          <!-- Badge Oficial Brand Book 2026 -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#141416] border border-white/[0.1] text-xs font-mono text-[#ffb3b3] uppercase tracking-widest shadow-lg">
            <span class="w-2 h-2 rounded-full bg-[#dc143c] animate-pulse shadow-[0_0_8px_#dc143c]"></span>
            <span>{siteConfig.origin} // BRAND ARCHIVE 2026</span>
          </div>

          <!-- Título y Logotipo Oficial Integrado -->
          <div class="space-y-3">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-[#141416] border border-white/[0.12] p-3 flex items-center justify-center shadow-[0_0_24px_rgba(220,20,60,0.3)]">
                <img
                  src="/brand/zairen_logo_oficial.svg"
                  alt="Logotipo Oficial Zairen Lab"
                  class="w-full h-full object-contain"
                />
              </div>
              <div>
                <span class="font-mono text-xs md:text-sm text-[#dc143c] uppercase tracking-widest font-bold block">
                  EXPERIMENTACIÓN TEXTIL
                </span>
                <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold font-display uppercase tracking-tight text-[#FAF9F6] leading-[0.92]">
                  {siteConfig.name}
                </h1>
              </div>
            </div>

            <!-- Slogan Oficial Brand Book -->
            <p class="text-xl sm:text-2xl md:text-3xl font-display font-medium text-[#FAF9F6]/90 italic">
              "{siteConfig.slogan}"
            </p>
          </div>

          <!-- Manifiesto Corto -->
          <p class="text-[#ac8888] font-body text-base md:text-lg max-w-xl leading-relaxed">
            Fusionamos la sobriedad del minimalismo japonés contemporáneo, subculturas anime mecha y cortes boxy de alta densidad (280-420 GSM). Ropa con siluetas que imponen presencia sin necesidad de ruido.
          </p>

          <!-- Botones de Acción -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/catalogo"
              class="px-8 py-4 rounded-full bg-[#dc143c] hover:bg-[#ff2d55] text-white text-xs font-mono uppercase tracking-widest font-bold shadow-[0_4px_24px_rgba(220,20,60,0.5)] hover:shadow-[0_8px_36px_rgba(222,5,65,0.7)] hover:scale-105 active:scale-95 transition-all flex items-center gap-3"
            >
              <span>Explorar Catálogo Completo</span>
              <span class="text-lg">→</span>
            </a>

            <a
              href="#contacto"
              class="px-6 py-4 rounded-full bg-[#141416] hover:bg-[#201f1f] text-[#FAF9F6] border border-white/[0.12] text-xs font-mono uppercase tracking-wider transition-all flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
              <span>Contacto WhatsApp</span>
            </a>
          </div>

          <!-- Métricas de Identidad -->
          <div class="grid grid-cols-3 gap-6 pt-6 border-t border-white/[0.08] w-full max-w-lg">
            <div>
              <span class="block text-2xl font-bold font-mono text-[#FAF9F6]">280-420</span>
              <span class="text-[11px] font-mono text-[#ac8888] uppercase tracking-wider">Gramaje GSM</span>
            </div>
            <div>
              <span class="block text-2xl font-bold font-mono text-[#dc143c]">100%</span>
              <span class="text-[11px] font-mono text-[#ac8888] uppercase tracking-wider">Algodón Peinado</span>
            </div>
            <div>
              <span class="block text-2xl font-bold font-mono text-[#FAF9F6]">TARIJA</span>
              <span class="text-[11px] font-mono text-[#ac8888] uppercase tracking-wider">Origen & Taller</span>
            </div>
          </div>
        </div>

        <!-- Visual Hero Editorial (5 cols) -->
        <div class="lg:col-span-5 relative mt-6 lg:mt-0">
          <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden bg-[#141416] border border-white/[0.12] shadow-[0_24px_64px_rgba(0,0,0,0.85)] group">
            <img
              src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?q=80&w=1000&auto=format&fit=crop"
              alt="Editorial Zairen Lab // Tokyo Apparel"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/30 to-transparent"></div>

            <!-- Placa Flotante Brand Book -->
            <div class="absolute bottom-6 inset-x-6 p-4 rounded-2xl bg-[#141416]/90 backdrop-blur-xl border border-white/[0.1] flex items-center justify-between">
              <div>
                <span class="text-[10px] font-mono text-[#dc143c] uppercase tracking-widest font-bold block">
                  FILOSOFÍA DE MARCA
                </span>
                <h3 class="font-display text-sm font-bold uppercase text-[#FAF9F6]">
                  "Menos ruido, más identidad"
                </h3>
              </div>
              <a
                href="/catalogo"
                class="px-3.5 py-1.5 rounded-full bg-[#dc143c] text-white text-xs font-mono uppercase font-bold hover:bg-[#ff2d55] transition-colors"
              >
                Ver Drops
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SECCIÓN: EL MANIFIESTO // CORTE SILENCIOSO -->
    <section id="manifiesto" class="w-full bg-[#0e0f11] py-24 border-y border-white/[0.06] relative">
      <div class="max-w-[1440px] mx-auto px-4 md:px-12">
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
          <span class="text-xs font-mono text-[#dc143c] bg-[#dc143c]/15 px-3.5 py-1 rounded-full uppercase tracking-widest font-bold">
            CONCEPTO RECTOR // BRAND BOOK
          </span>
          <h2 class="text-3xl md:text-5xl font-bold font-display uppercase tracking-tight text-[#FAF9F6]">
            El Corte Silencioso
          </h2>
          <p class="text-sm md:text-base font-body text-[#ac8888] leading-relaxed">
            Una declaración estética frente a la saturación visual contemporánea. Creemos en prendas que no necesitan gritar para hacerse notar.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Pilar 1 -->
          <div class="p-8 rounded-3xl bg-[#141416]/70 border border-white/[0.08] hover:border-[#dc143c]/40 transition-all space-y-4 group">
            <div class="w-12 h-12 rounded-2xl bg-[#0a0a0a] border border-white/[0.08] flex items-center justify-center text-xl font-mono text-[#dc143c] font-bold group-hover:scale-110 transition-transform">
              01
            </div>
            <h3 class="font-display text-xl font-bold uppercase text-[#FAF9F6]">
              Rebelión Silenciosa
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Frente al maximalismo efímero, optamos por cortes geométricos, caídas limpias y proporciones sobrias que resisten el paso de las temporadas.
            </p>
          </div>

          <!-- Pilar 2 -->
          <div class="p-8 rounded-3xl bg-[#141416]/70 border border-white/[0.08] hover:border-[#dc143c]/40 transition-all space-y-4 group">
            <div class="w-12 h-12 rounded-2xl bg-[#0a0a0a] border border-white/[0.08] flex items-center justify-center text-xl font-mono text-[#dc143c] font-bold group-hover:scale-110 transition-transform">
              02
            </div>
            <h3 class="font-display text-xl font-bold uppercase text-[#FAF9F6]">
              Wabi Code
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Inspirado en la simplicidad japonesa. La belleza radica en la densidad del tejido, el tacto del algodón pesado y las texturas industriales limpias.
            </p>
          </div>

          <!-- Pilar 3 -->
          <div class="p-8 rounded-3xl bg-[#141416]/70 border border-white/[0.08] hover:border-[#dc143c]/40 transition-all space-y-4 group">
            <div class="w-12 h-12 rounded-2xl bg-[#0a0a0a] border border-white/[0.08] flex items-center justify-center text-xl font-mono text-[#dc143c] font-bold group-hover:scale-110 transition-transform">
              03
            </div>
            <h3 class="font-display text-xl font-bold uppercase text-[#FAF9F6]">
              Identidad en Reposo
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              La prenda acompaña el movimiento natural del cuerpo sin rigideces. Un confort robusto y pesado concebido para el día a día.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SECCIÓN: LAS 3 LÍNEAS DE ROPA // BENTO GRID -->
    <section id="lineas" class="w-full py-24 px-4 md:px-12 max-w-[1440px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-14">
        <div>
          <span class="text-xs font-mono text-[#dc143c] bg-[#dc143c]/15 px-3 py-1 rounded-full uppercase tracking-wider font-bold">
            LÍNEAS DE CONFECCIÓN // ARCHIVO
          </span>
          <h2 class="text-3xl md:text-5xl font-bold font-display uppercase tracking-tight text-[#FAF9F6] mt-3">
            Tres Expresiones Textil
          </h2>
        </div>
        <a
          href="/catalogo"
          class="inline-flex items-center gap-2 text-xs font-mono text-[#dc143c] uppercase tracking-wider font-bold hover:underline"
        >
          <span>Ver todas las prendas en el catálogo</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Línea 1: Poleras Limpias -->
        <article class="relative rounded-3xl overflow-hidden bg-[#141416] border border-white/[0.08] p-8 flex flex-col justify-between min-h-[460px] group shadow-xl">
          <div class="space-y-4 z-10">
            <span class="text-xs font-mono text-[#ffb3b3] uppercase tracking-widest font-bold block">
              LÍNEA 01 // BÁSICOS
            </span>
            <h3 class="text-2xl font-bold font-display uppercase text-[#FAF9F6]">
              Poleras Limpias
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Confección de máxima densidad sin impresiones invasivas. Algodón peinado 280 GSM con silueta boxy recta y cuello reforzado de 3.5 cm.
            </p>
          </div>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden mt-6 bg-[#0a0a0a]">
            <img
              src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=600&auto=format&fit=crop"
              alt="Poleras Limpias Zairen Lab"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <a
            href="/catalogo"
            class="mt-6 w-full py-3 rounded-full bg-[#1c1b1b] hover:bg-[#dc143c] text-white text-xs font-mono uppercase tracking-wider font-bold text-center transition-colors block"
          >
            Explorar Línea 01
          </a>
        </article>

        <!-- Línea 2: Diseño Propio -->
        <article class="relative rounded-3xl overflow-hidden bg-[#141416] border border-white/[0.08] p-8 flex flex-col justify-between min-h-[460px] group shadow-xl">
          <div class="space-y-4 z-10">
            <span class="text-xs font-mono text-[#dc143c] uppercase tracking-widest font-bold block">
              LÍNEA 02 // MECHA TECH
            </span>
            <h3 class="text-2xl font-bold font-display uppercase text-[#FAF9F6]">
              Diseño Propio
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Ilustraciones originales inspiradas en anime mecha, armaduras de combate, tipografía Shinjuku y tecnología distópica. Serigrafía tacto cero de alta durabilidad.
            </p>
          </div>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden mt-6 bg-[#0a0a0a]">
            <img
              src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?q=80&w=600&auto=format&fit=crop"
              alt="Diseño Propio Zairen Lab"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <a
            href="/catalogo"
            class="mt-6 w-full py-3 rounded-full bg-[#1c1b1b] hover:bg-[#dc143c] text-white text-xs font-mono uppercase tracking-wider font-bold text-center transition-colors block"
          >
            Explorar Línea 02
          </a>
        </article>

        <!-- Línea 3: Personalizadas -->
        <article class="relative rounded-3xl overflow-hidden bg-[#141416] border border-white/[0.08] p-8 flex flex-col justify-between min-h-[460px] group shadow-xl">
          <div class="space-y-4 z-10">
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest font-bold block">
              LÍNEA 03 // TALLER
            </span>
            <h3 class="text-2xl font-bold font-display uppercase text-[#FAF9F6]">
              Personalizadas
            </h3>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Servicio a medida para proyectos exclusivos, marcas amigas y encargos especiales. Selecciona gramajes, siluetas y acabados de taller.
            </p>
          </div>
          <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden mt-6 bg-[#0a0a0a]">
            <img
              src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=600&auto=format&fit=crop"
              alt="Personalizadas Zairen Lab"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <a
            href="#contacto"
            class="mt-6 w-full py-3 rounded-full bg-[#1c1b1b] hover:bg-emerald-600 text-white text-xs font-mono uppercase tracking-wider font-bold text-center transition-colors block"
          >
            Cotizar en Taller
          </a>
        </article>
      </div>
    </section>

    <!-- 4. SECCIÓN: ESPECIFICACIONES TEXTILES // BLUEPRINT -->
    <section class="w-full bg-[#0a0a0a] py-24 border-t border-white/[0.06]">
      <div class="max-w-[1440px] mx-auto px-4 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 space-y-6">
            <span class="text-xs font-mono text-[#dc143c] uppercase tracking-widest font-bold">
              ESTÁNDARES DE TALLER // 2026
            </span>
            <h2 class="text-3xl md:text-5xl font-bold font-display uppercase tracking-tight text-[#FAF9F6]">
              Ingeniería en Cada Fibra
            </h2>
            <p class="text-sm font-body text-[#ac8888] leading-relaxed">
              Cada prenda pasa por un control estricto de hilado, corte y fijación de pigmento antes de llegar a tus manos.
            </p>

            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-3 p-4 rounded-2xl bg-[#141416] border border-white/[0.06]">
                <span class="w-8 h-8 rounded-xl bg-[#dc143c]/15 text-[#dc143c] flex items-center justify-center font-bold text-sm shrink-0">
                  01
                </span>
                <div>
                  <h4 class="font-mono text-sm uppercase font-bold text-[#FAF9F6]">
                    Algodón Peinado 280-420 GSM
                  </h4>
                  <p class="text-xs font-body text-[#ac8888] mt-1">
                    Cuerpo rígido y estructurado que mantiene el corte boxy incluso tras decenas de lavados.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 rounded-2xl bg-[#141416] border border-white/[0.06]">
                <span class="w-8 h-8 rounded-xl bg-[#dc143c]/15 text-[#dc143c] flex items-center justify-center font-bold text-sm shrink-0">
                  02
                </span>
                <div>
                  <h4 class="font-mono text-sm uppercase font-bold text-[#FAF9F6]">
                    Serigrafía al Agua Tacto Cero
                  </h4>
                  <p class="text-xs font-body text-[#ac8888] mt-1">
                    Sin plástico pegajoso ni rigidez. La tinta se fusiona directamente con la fibra del algodón.
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-4 rounded-2xl bg-[#141416] border border-white/[0.06]">
                <span class="w-8 h-8 rounded-xl bg-[#dc143c]/15 text-[#dc143c] flex items-center justify-center font-bold text-sm shrink-0">
                  03
                </span>
                <div>
                  <h4 class="font-mono text-sm uppercase font-bold text-[#FAF9F6]">
                    Cuello Ribete de 3.5 cm Reforzado
                  </h4>
                  <p class="text-xs font-body text-[#ac8888] mt-1">
                    Incorpora spandex de memoria para evitar que el cuello se venza o deforme.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="relative rounded-3xl overflow-hidden bg-[#141416] border border-white/[0.08] shadow-2xl">
              <img
                src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=1000&auto=format&fit=crop"
                alt="Detalle Textil Zairen Lab"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-[#0a0a0a]/80 backdrop-blur-md border border-white/[0.08] text-center">
                <span class="font-mono text-xs text-[#ffb3b3] uppercase tracking-wider block">
                  CONFECCIONADO EN TARIJA // ENVÍO NACIONAL A TODA BOLIVIA
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. SECCIÓN: MÓDULO DE CONTACTO DIRECTO POR WHATSAPP -->
    <section id="contacto" class="w-full py-24 px-4 md:px-12 bg-gradient-to-b from-[#0a0a0a] via-[#141416] to-[#0a0a0a] border-t border-white/[0.06]">
      <div class="max-w-[1440px] mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span class="text-xs font-mono text-[#25D366] bg-[#25D366]/15 px-3.5 py-1 rounded-full uppercase tracking-widest font-bold">
            04 // CANAL DIRECTO
          </span>
          <h2 class="text-3xl md:text-5xl font-bold font-display uppercase tracking-tight text-[#FAF9F6]">
            ¿Tienes alguna consulta?
          </h2>
          <p class="text-sm font-body text-[#ac8888]">
            Escríbenos directamente para resolver cualquier duda sobre prendas, tallas, personalizaciones o envíos.
          </p>
        </div>

        <!-- Módulo Interactivo de Contacto Directo WhatsApp -->
        <WhatsAppContactModule client:load />
      </div>
    </section>
  </main>

  <!-- Carrito Drawer Global -->
  <CarritoDrawer client:load />

  <!-- Footer Corporativo -->
  <Footer />
</Layout>
