---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import SplashLoader from '../components/common/SplashLoader.astro';
import { CatalogoGrid } from '../components/catalogo/CatalogoGrid';
import { CarritoDrawer } from '../components/catalogo/CarritoDrawer';
import { siteConfig } from '../config/site';
import { supabase, isSupabaseConfigured } from '../lib/supabase';
import type { TarjetaPoleraProps } from '../components/catalogo/TarjetaPolera';

// Carga de productos directamente desde la base de datos de Supabase
let products: TarjetaPoleraProps[] = [];
let collections: Array<{ id: string; nombre: string; slug: string }> = [];

if (isSupabaseConfigured) {
  try {
    const { data: dbProducts, error: pError } = await supabase
      .from('vw_catalogo_publico')
      .select('*')
      .limit(100);

    if (!pError && dbProducts && dbProducts.length > 0) {
      products = dbProducts.map((p) => {
        const stockPorTalla: Record<string, number> = {};
        if (p.atributos && typeof p.atributos === 'object') {
          Object.entries(p.atributos).forEach(([k, v]) => {
            const match = k.toLowerCase().match(/^stock_([a-z0-9]+)$/);
            if (match) {
              const sizeKey = match[1].toUpperCase();
              stockPorTalla[sizeKey] = parseInt(String(v), 10) || 0;
            }
          });
        }

        const tallasConStock = Object.keys(stockPorTalla);
        const tallasFinal = tallasConStock.length > 0
          ? tallasConStock
          : (p.tallas && p.tallas.length > 0 ? p.tallas : ['S', 'M', 'L', 'XL']);

        const stockCalculado = Object.keys(stockPorTalla).length > 0
          ? Object.values(stockPorTalla).reduce((a, b) => a + b, 0)
          : Number(p.stock_disponible || 0);

        return {
          id: p.id_producto,
          slug: p.slug,
          nombre: p.nombre,
          precio: Number(p.precio_venta),
          coleccion: p.coleccion || 'General',
          coleccionSlug: p.coleccion_slug || (p.coleccion ? p.coleccion.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : 'general'),
          idColeccion: p.id_coleccion,
          subtitulo: p.descripcion || 'Algodón pesado 280 GSM',
          imagen: p.imagen_portada || 'https://res.cloudinary.com/ds4qnoypm/image/upload/v1791690155/zairen_logo_oficial_nehjev.webp',
          imagenDorsal: p.imagen_dorsal,
          tallas: tallasFinal,
          stockPorTalla: Object.keys(stockPorTalla).length > 0 ? stockPorTalla : undefined,
          stockDisponible: Math.max(Number(p.stock_disponible || 0), stockCalculado),
          esPrioritario: Boolean(p.es_prioritario),
          estadoComercial: p.estado_comercial || 'ninguno',
        };
      });
    }

    const { data: dbCols, error: cError } = await supabase
      .from('coleccion')
      .select('id, nombre, slug')
      .eq('activa', true)
      .order('orden', { ascending: true });

    if (!cError && dbCols && dbCols.length > 0) {
      // Filtrar para mostrar unicamente colecciones que tengan productos activos
      collections = dbCols.filter((col) => {
        const colSlugNorm = (col.slug || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        const colNameNorm = (col.nombre || '').toLowerCase().replace(/[^a-z0-9]/g, '');
        return products.some((prod) => {
          const prodColNorm = (prod.coleccion || '').toLowerCase().replace(/[^a-z0-9]/g, '');
          const prodSlugNorm = ((prod as any).coleccionSlug || '').toLowerCase().replace(/[^a-z0-9]/g, '');
          return (
            (prod as any).idColeccion === col.id ||
            prodColNorm === colNameNorm ||
            prodSlugNorm === colSlugNorm ||
            prodColNorm.includes(colNameNorm) ||
            colNameNorm.includes(prodColNorm)
          );
        });
      });
    }
  } catch (e) {
    console.warn('Error al cargar catálogo desde Supabase:', e);
  }
}
---

<Layout title={`${siteConfig.name} // Catálogo Oficial`}>
  <!-- Pantalla de Carga Inicial Simplificada -->
  <SplashLoader />

  <!-- Navbar Minimalista Fijo -->
  <Navbar activePath="/" />

  <!-- Pantalla Principal: Catálogo Exclusivo Protagónico -->
  <main class="min-h-screen bg-[#0A0A0A] pt-20 transition-colors">
    <CatalogoGrid
      client:load
      initialProducts={products}
      collections={collections}
    />
  </main>

  <!-- Carrito Drawer Global -->
  <CarritoDrawer client:load />

  <!-- Footer Oficial -->
  <Footer />
</Layout>
