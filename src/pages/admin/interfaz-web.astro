---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { siteConfig } from '../../config/site';
import { ConfiguracionWeb } from '../../components/admin/settings/ConfiguracionWeb';
---

<AdminLayout title={`Interfaz Web // ${siteConfig.name}`} activePath="interfaz-web">
  <div class="max-w-[1440px] mx-auto px-4 md:px-12 flex flex-col gap-8 pb-16">
    <ConfiguracionWeb client:load />
  </div>
</AdminLayout>
