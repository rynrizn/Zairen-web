---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import { DetalleProducto } from '../../components/catalogo/DetalleProducto';
import { CarritoDrawer } from '../../components/catalogo/CarritoDrawer';
import { mockProducts } from '../../data/mockProducts';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  let products = mockProducts;

  if (isSupabaseConfigured) {
    try {
      const { data: dbProducts, error } = await supabase
        .from('producto')
        .select('id, slug, nombre')
        .eq('activo', true);

      if (!error && dbProducts && dbProducts.length > 0) {
        // Retornar rutas tanto para slug como para ID
        const paths = dbProducts.flatMap((p) => [
          { params: { id: p.slug } },
          { params: { id: p.id } },
        ]);
        return paths;
      }
    } catch (e) {}
  }

  // Rutas estáticas de respaldo con mockProducts
  return products.flatMap((p) => [
    { params: { id: p.slug } },
    { params: { id: p.id } },
  ]);
}

const { id } = Astro.params;

// Buscar producto
let product = mockProducts.find((p) => p.slug === id || p.id === id) || mockProducts[0];
let productImages = product.imagenes || [product.imagen];

if (isSupabaseConfigured) {
  try {
    const { data: dbProd, error } = await supabase
      .from('vw_catalogo_publico')
      .select('*')
      .or(`slug.eq.${id},id_producto.eq.${id}`)
      .maybeSingle();

    if (!error && dbProd) {
      product = {
        id: dbProd.id_producto,
        slug: dbProd.slug,
        nombre: dbProd.nombre,
        precio: Number(dbProd.precio_venta),
        coleccion: dbProd.coleccion || 'DROP 01',
        seccion: dbProd.coleccion || 'DROP 01',
        tipo: 'Polera',
        descripcion: dbProd.descripcion || '',
        imagen: dbProd.imagen_portada || mockProducts[0].imagen,
        imagenDorsal: dbProd.imagen_dorsal,
        tallas: dbProd.tallas && dbProd.tallas.length > 0 ? dbProd.tallas : ['S', 'M', 'L', 'XL'],
        stockDisponible: Number(dbProd.stock_disponible || 0),
        esPrioritario: Boolean(dbProd.es_prioritario),
        estadoComercial: dbProd.estado_comercial || 'disponible',
      };

      // Consultar imágenes de la tabla imagen si existen
      const { data: dbImgs } = await supabase
        .from('imagen')
        .select('url_imagen')
        .eq('producto_id', dbProd.id_producto)
        .order('orden', { ascending: true });

      if (dbImgs && dbImgs.length > 0) {
        productImages = dbImgs.map((img) => img.url_imagen);
      } else {
        productImages = [product.imagen];
        if (product.imagenDorsal) productImages.push(product.imagenDorsal);
      }
    }
  } catch (e) {}
}
---

<Layout
  title={`${product.nombre} // ${siteConfig.name}`}
  description={`${product.descripcion || product.nombre} • Precio: Bs ${product.precio.toFixed(2)} • Zairen Lab // Streetwear & Aesthetic Studio.`}
  image={product.imagen}
  type="product"
  price={product.precio}
>
  <Navbar />

  <main class="pt-24 pb-16 min-h-screen">
    <DetalleProducto
      client:load
      id={product.id}
      slug={product.slug}
      nombre={product.nombre}
      precio={product.precio}
      coleccion={product.coleccion}
      seccion={product.seccion}
      tipo={product.tipo}
      descripcion={product.descripcion}
      imagenes={productImages}
      tallas={product.tallas}
      stockDisponible={product.stockDisponible}
      estadoComercial={product.estadoComercial}
    />
  </main>

  <!-- Carrito Drawer Global -->
  <CarritoDrawer client:load />

  <Footer />
</Layout>
