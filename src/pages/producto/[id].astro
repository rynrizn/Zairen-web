---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/common/Navbar.astro';
import Footer from '../../components/common/Footer.astro';
import { DetalleProducto } from '../../components/catalogo/DetalleProducto';
import { CarritoDrawer } from '../../components/catalogo/CarritoDrawer';
import { supabase } from '../../lib/supabase';
import { siteConfig } from '../../config/site';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

// Validar si el identificador es un UUID o un slug
const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);

let dbProd: any = null;

// 1. Búsqueda primaria en la vista pública
if (isUuid) {
  const { data, error } = await supabase
    .from('vw_catalogo_publico')
    .select('*')
    .eq('id_producto', id)
    .maybeSingle();
  if (!error && data) dbProd = data;
} else {
  const { data, error } = await supabase
    .from('vw_catalogo_publico')
    .select('*')
    .eq('slug', id)
    .maybeSingle();
  if (!error && data) dbProd = data;
}

// 2. Fallback de contingencia directamente a la tabla base producto
if (!dbProd) {
  const query = supabase.from('producto').select('*');
  const { data, error } = isUuid
    ? await query.eq('id_producto', id).maybeSingle()
    : await query.eq('slug', id).maybeSingle();

  if (!error && data) {
    dbProd = data;
  }
}

if (!dbProd) {
  console.warn(`[Zairen Lab] Producto no encontrado con id/slug: "${id}". Redirigiendo al catálogo.`);
  return Astro.redirect('/');
}

const stockPorTalla: Record<string, number> = {};
if (dbProd.atributos && typeof dbProd.atributos === 'object') {
  Object.entries(dbProd.atributos).forEach(([k, v]) => {
    const match = k.toLowerCase().match(/^stock_([a-z0-9]+)$/);
    if (match) {
      const sizeKey = match[1].toUpperCase();
      stockPorTalla[sizeKey] = parseInt(String(v), 10) || 0;
    }
  });
}

if (Object.keys(stockPorTalla).length === 0) {
  try {
    const { data: attrData } = await supabase
      .from('atributo_producto')
      .select('clave, valor')
      .eq('producto_id', dbProd.id_producto)
      .ilike('clave', 'stock_%');
    if (attrData && attrData.length > 0) {
      attrData.forEach((a: any) => {
        const match = a.clave.toLowerCase().match(/^stock_([a-z0-9]+)$/);
        if (match) {
          stockPorTalla[match[1].toUpperCase()] = parseInt(String(a.valor), 10) || 0;
        }
      });
    }
  } catch (e) {}
}

const tallasConStock = Object.keys(stockPorTalla);
const tallasFinal = tallasConStock.length > 0
  ? tallasConStock
  : (dbProd.tallas && dbProd.tallas.length > 0 ? dbProd.tallas : ['S', 'M', 'L', 'XL']);

const stockCalculado = Object.keys(stockPorTalla).length > 0
  ? Object.values(stockPorTalla).reduce((a, b) => a + b, 0)
  : Number(dbProd.stock_disponible || 0);

const product = {
  id: dbProd.id_producto,
  slug: dbProd.slug,
  nombre: dbProd.nombre,
  precio: Number(dbProd.precio_venta),
  coleccion: dbProd.coleccion || 'General',
  seccion: dbProd.coleccion || 'General',
  tipo: 'Polera',
  descripcion: dbProd.descripcion || '',
  imagen: dbProd.imagen_portada || 'https://res.cloudinary.com/ds4qnoypm/image/upload/v1791690155/zairen_logo_oficial_nehjev.webp',
  imagenDorsal: dbProd.imagen_dorsal,
  tallas: tallasFinal,
  stockPorTalla: Object.keys(stockPorTalla).length > 0 ? stockPorTalla : undefined,
  stockDisponible: Math.max(Number(dbProd.stock_disponible || 0), stockCalculado),
  esPrioritario: Boolean(dbProd.es_prioritario),
  estadoComercial: dbProd.estado_comercial || 'disponible',
};

let productImages: string[] = [product.imagen];
if (product.imagenDorsal) productImages.push(product.imagenDorsal);

try {
  const { data: dbImgs } = await supabase
    .from('imagen')
    .select('url_imagen')
    .eq('producto_id', dbProd.id_producto)
    .order('orden', { ascending: true });

  if (dbImgs && dbImgs.length > 0) {
    const additional = dbImgs.map((img) => img.url_imagen).filter(Boolean);
    const combined = Array.from(new Set([product.imagen, product.imagenDorsal, ...additional].filter(Boolean))) as string[];
    if (combined.length > 0) {
      productImages = combined;
    }
  }
} catch (e) {}
---

<Layout
  title={`${product.nombre} // ${siteConfig.name}`}
  description={`${product.descripcion || product.nombre} • Precio: Bs ${product.precio.toFixed(2)} • Zairen Lab // Streetwear & Aesthetic Studio.`}
  image={product.imagen}
  type="product"
  price={product.precio}
>
  <Navbar />

  <main class="pt-24 pb-16 min-h-screen">
    <DetalleProducto
      client:load
      id={product.id}
      slug={product.slug}
      nombre={product.nombre}
      precio={product.precio}
      coleccion={product.coleccion}
      seccion={product.seccion}
      tipo={product.tipo}
      descripcion={product.descripcion}
      imagenes={productImages}
      tallas={product.tallas}
      stockDisponible={product.stockDisponible}
      stockPorTalla={product.stockPorTalla}
      estadoComercial={product.estadoComercial}
    />
  </main>

  <!-- Carrito Drawer Global -->
  <CarritoDrawer client:idle />

  <Footer />
</Layout>
