---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { TurnstileWidget } from '../components/common/TurnstileWidget';

const redirectUrl = Astro.url.searchParams.get('redirect') || '/admin';
---

<Layout title="Ingresar">
  <main class="flex-1 flex items-center justify-center min-h-screen px-4 py-12 relative overflow-hidden">
    <!-- Halo carmesí de fondo -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-[#dc143c]/15 rounded-none blur-[140px] pointer-events-none -z-10"></div>

    <div class="login-card w-full max-w-md bg-[#141416]/95 backdrop-blur-2xl p-8 rounded-none border border-[#201f1f] shadow-[0_16px_48px_rgba(0,0,0,0.8)] relative overflow-hidden">
      <!-- Barra decorativa carmesí superior -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#dc143c] via-[#de0541] to-[#dc143c]"></div>

      <!-- Cabecera -->
      <div class="flex flex-col items-center text-center mb-8">
        <div class="mb-4">
          <img
            src="https://res.cloudinary.com/ds4qnoypm/image/upload/v1791690155/zairen_logo_oficial_nehjev.webp"
            alt="Zairen Lab Logo Oficial"
            class="w-14 h-14 object-contain filter drop-shadow-[0_0_16px_rgba(220,20,60,0.45)]"
          />
        </div>
        <h1 class="text-xl font-bold font-display uppercase tracking-tight text-[#e5e2e1]">
          {siteConfig.name} <span class="text-[#dc143c] font-mono text-sm">// CORE</span>
        </h1>
        <p class="login-label text-xs font-mono text-[#ac8888] uppercase tracking-wider mt-1">
          Panel de Control & Inventario
        </p>
      </div>

      <!-- Mensaje de error -->
      <div id="login-error" class="hidden mb-5 p-3 rounded-none bg-[#93000a]/20 border border-[#93000a]/40 text-[#ffb4ab] text-xs font-mono"></div>

      <!-- Formulario -->
      <form id="login-form" class="space-y-4">
        <input type="hidden" id="redirect-url" value={redirectUrl} />

        <div>
          <label for="email" class="login-label block text-xs font-mono text-[#ac8888] uppercase tracking-wider mb-1.5">
            Correo Electrónico
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="admin@zairenlab.com"
            class="login-input w-full bg-[#1c1b1b] border border-[#201f1f] rounded-none px-4 py-2.5 text-sm text-[#e5e2e1] font-mono placeholder:text-white/20 focus:outline-none focus:border-[#dc143c] focus:ring-1 focus:ring-[#dc143c] transition-all"
          />
        </div>

        <div>
          <label for="password" class="login-label flex items-center gap-1.5 text-xs font-mono text-[#ac8888] uppercase tracking-wider mb-1.5">
            <!-- Icono Lock Lucide Oficial -->
            <svg class="w-3.5 h-3.5 text-[#dc143c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Contraseña</span>
          </label>
          <div class="relative">
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="login-input w-full bg-[#1c1b1b] border border-[#201f1f] rounded-none px-4 py-2.5 pr-11 text-sm text-[#e5e2e1] font-mono placeholder:text-white/20 focus:outline-none focus:border-[#dc143c] focus:ring-1 focus:ring-[#dc143c] transition-all"
            />
            <button
              type="button"
              id="toggle-password-btn"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[#ac8888] hover:text-white p-1 cursor-pointer transition-colors"
              title="Mostrar u ocultar contraseña"
              aria-label="Alternar visibilidad de contraseña"
            >
              <!-- Icono Ojito Abierto -->
              <svg id="eye-open-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <!-- Icono Ojito Tachado -->
              <svg id="eye-off-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="2" y1="2" x2="22" y2="22" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Verificación Cloudflare Turnstile Oficial -->
        <div class="pt-2">
          <TurnstileWidget client:load id="login-turnstile" onVerify="window.__onLoginTurnstileVerify" />
        </div>

        <button
          type="submit"
          id="submit-btn"
          disabled
          class="w-full py-3 rounded-none bg-[#dc143c] disabled:opacity-50 disabled:cursor-not-allowed hover:bg-[#ff2d55] text-white font-mono text-sm uppercase tracking-wider font-bold shadow-[0_4px_20px_rgba(220,20,60,0.4)] transition-all cursor-pointer mt-2 border border-[#dc143c]"
        >
          Iniciar Sesión // Acceder
        </button>
      </form>

      <div class="mt-6 pt-4 border-t border-white/[0.06] text-center">
        <a href="/" class="login-label text-xs font-mono text-[#ac8888] hover:text-[#e5e2e1] transition-colors">
          ← Volver al Catálogo Público
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  :global(html.light) .login-card {
    background-color: #FFFFFF !important;
    border-color: #DCD9D2 !important;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.08) !important;
  }
  :global(html.light) .login-input {
    background-color: #F8F7F4 !important;
    border-color: #DCD9D2 !important;
    color: #141416 !important;
  }
  :global(html.light) .login-input::placeholder {
    color: #8F8F8C !important;
  }
  :global(html.light) .login-label {
    color: #555558 !important;
  }
  :global(html.light) .login-icon-box {
    background-color: #F8F7F4 !important;
    border-color: #DCD9D2 !important;
  }
</style>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  // Guarda de sesión activa anti-bucle con validación estricta de servidor
  (async () => {
    const errorBox = document.getElementById('login-error');
    try {
      const loopCountKey = 'zairen_login_redirect_attempts';
      const lastAttemptKey = 'zairen_login_last_attempt_time';
      const attempts = parseInt(sessionStorage.getItem(loopCountKey) || '0', 10);
      const lastTime = parseInt(sessionStorage.getItem(lastAttemptKey) || '0', 10);
      const now = Date.now();

      // Detección anti-bucle: si hubo rebotes continuos en menos de 6 segundos, romper el bucle
      if (attempts >= 2 && now - lastTime < 6000) {
        sessionStorage.removeItem(loopCountKey);
        await supabase.auth.signOut({ scope: 'local' });
        document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'sb-refresh-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        localStorage.removeItem('zairen_user_id');
        localStorage.removeItem('zairen_user_role');
        if (errorBox) {
          errorBox.textContent = 'Tu sesión anterior ya no es válida o fue cerrada en otro dispositivo. Por favor ingresa tus credenciales.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      // Validar con el servidor de Supabase mediante getUser(), NO simplemente getSession() local
      const { data: { user }, error: userErr } = await supabase.auth.getUser();

      if (user && !userErr) {
        sessionStorage.setItem(loopCountKey, String(attempts + 1));
        sessionStorage.setItem(lastAttemptKey, String(now));
        const redirect = (document.getElementById('redirect-url') as HTMLInputElement)?.value || '/admin';
        window.location.replace(redirect);
      } else {
        // Token inválido o revocado -> limpiar almacenamiento huérfano y permitir login
        sessionStorage.removeItem(loopCountKey);
        await supabase.auth.signOut({ scope: 'local' });
        document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        document.cookie = 'sb-refresh-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        localStorage.removeItem('zairen_user_id');
        localStorage.removeItem('zairen_user_role');
      }
    } catch (e) {
      sessionStorage.removeItem('zairen_login_redirect_attempts');
    }
  })();

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorBox = document.getElementById('login-error') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const redirectInput = document.getElementById('redirect-url') as HTMLInputElement;

  // Toggle visibilidad de contraseña (ojito)
  const toggleBtn = document.getElementById('toggle-password-btn') as HTMLButtonElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const eyeOpenIcon = document.getElementById('eye-open-icon') as SVGElement;
  const eyeOffIcon = document.getElementById('eye-off-icon') as SVGElement;

  toggleBtn?.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      eyeOpenIcon?.classList.add('hidden');
      eyeOffIcon?.classList.remove('hidden');
    } else {
      passwordInput.type = 'password';
      eyeOpenIcon?.classList.remove('hidden');
      eyeOffIcon?.classList.add('hidden');
    }
  });

  let isTurnstileVerified = false;

  // Callback global y CustomEvent para Turnstile
  (window as any).__onLoginTurnstileVerify = (token: string) => {
    isTurnstileVerified = true;
    submitBtn.disabled = false;
  };

  document.addEventListener('turnstile:verified', () => {
    isTurnstileVerified = true;
    submitBtn.disabled = false;
  });


  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    if (!isTurnstileVerified) {
      errorBox.textContent = 'Por favor completa la verificación de seguridad Cloudflare.';
      errorBox.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Autenticando...';

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorBox.textContent = error.message || 'Credenciales incorrectas';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Iniciar Sesión // Acceder';
        return;
      }

      if (data.session && data.session.user) {
        // Guardar tokens en cookies para middleware
        document.cookie = `sb-access-token=${data.session.access_token}; path=/; max-age=604800; SameSite=Lax`;
        document.cookie = `sb-refresh-token=${data.session.refresh_token}; path=/; max-age=604800; SameSite=Lax`;

        // Verificar o crear perfil en public.perfil como SUPERADMIN
        let userRole = 'SUPERADMIN';
        try {
          const { data: profile } = await supabase
            .from('perfil')
            .select('*')
            .eq('id', data.session.user.id)
            .maybeSingle();

          if (!profile) {
            // Asignar SUPERADMIN al primer usuario / dueño de la tienda
            await supabase.from('perfil').insert({
              id: data.session.user.id,
              nombre_completo: data.session.user.user_metadata?.full_name || email.split('@')[0].toUpperCase(),
              rol: 'SUPERADMIN',
              activo: true,
            });
            userRole = 'SUPERADMIN';
          } else {
            userRole = profile.rol || 'SUPERADMIN';
          }
        } catch (perfilErr) {
          console.warn('Perfil warning:', perfilErr);
        }

        localStorage.setItem('zairen_user_id', data.session.user.id);
        localStorage.setItem('zairen_user_email', data.session.user.email || email);
        localStorage.setItem('zairen_user_role', userRole);

        sessionStorage.removeItem('zairen_login_redirect_attempts');
        window.location.href = redirectInput.value || '/admin';
      }
    } catch (err: any) {
      errorBox.textContent = err.message || 'Error inesperado de autenticación';
      errorBox.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Iniciar Sesión // Acceder';
    }
  });
</script>
