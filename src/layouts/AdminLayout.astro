---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { Toaster } from '../components/ui/Toaster';
import { AdminSidebar } from '../components/admin/layout/AdminSidebar';

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'Admin // ZAIREN LAB', activePath = 'panel' } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {/* Script Inline de Tema para Admin (Sincronizado con localStorage) */}
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('zairen_theme')) {
          return localStorage.getItem('zairen_theme');
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-[#0A0A0A] text-[#FAF9F6] antialiased min-h-screen flex flex-col font-body relative">
    {/* Textura sutil de ruido Zen Washi / Sumi-iro */}
    <div class="bg-noise" aria-hidden="true"></div>

    <Toaster client:load />

    {/* Barra Lateral Colapsable y Drawer Móvil (Isla React) */}
    <AdminSidebar client:load activePath={activePath} />

    {/* Área de Contenido Principal Dinámica */}
    <main
      id="admin-main-wrapper"
      class="w-full flex-1 pt-20 md:pt-6 pb-12 px-4 md:px-8 transition-all duration-300 md:pl-64 relative z-10"
    >
      <div class="max-w-[1600px] mx-auto">
        {/* Topbar de Administración Desktop con Selector de Tema */}
        <div class="hidden md:flex items-center justify-between px-2 pb-5 mb-6 border-b border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 bg-[#dc143c]"></span>
            <span class="font-mono text-xs text-[#ffb3b3] uppercase tracking-wider font-bold">
              ZAIREN LAB // SISTEMA DE CONTROL CORE
            </span>
          </div>

          <div class="flex items-center gap-3">
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-none bg-[#141416] hover:bg-[#1c1b1b] border border-white/[0.08] text-[#8F8F8C] hover:text-white font-mono text-xs uppercase tracking-wider flex items-center gap-2 transition-colors"
            >
              <span>Ver Tienda</span>
              <span class="text-[10px]">↗</span>
            </a>

            {/* Toggle de Modo Claro / Oscuro en Admin */}
            <button
              id="admin-theme-toggle"
              type="button"
              aria-label="Cambiar tema de color"
              title="Alternar modo claro / oscuro"
              class="w-8 h-8 rounded-none bg-[#141416] hover:bg-[#1c1b1b] border border-white/[0.08] text-[#8F8F8C] hover:text-white flex items-center justify-center transition-colors cursor-pointer"
            >
              <span id="theme-icon-dark" class="material-symbols-outlined text-[18px]">dark_mode</span>
              <span id="theme-icon-light" class="material-symbols-outlined text-[18px]">light_mode</span>
            </button>
          </div>
        </div>

        <slot />
      </div>
    </main>

    {/* Script de ajuste dinámico de padding, guarda de autenticación y cambio de tema */}
    <script>
      import { supabase, isSupabaseConfigured } from '../lib/supabase';

      // 1. Guarda de autenticación client-side estricta (Anti-Console Bypass)
      async function verifyAdminAuth() {
        if (!isSupabaseConfigured) {
          const hasDemoCookie = document.cookie.includes('sb-access-token=demo-admin-token');
          if (!hasDemoCookie && window.location.pathname.startsWith('/admin')) {
            window.location.replace(`/login?redirect=${encodeURIComponent(window.location.pathname)}`);
          }
          return;
        }

        // Validación criptográfica de sesión real
        const { data: { session }, error } = await supabase.auth.getSession();

        if (error || !session) {
          document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          document.cookie = 'sb-refresh-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          localStorage.removeItem('zairen_user_id');
          localStorage.removeItem('zairen_user_role');
          window.location.replace(`/login?redirect=${encodeURIComponent(window.location.pathname)}`);
          return;
        }

        try {
          const { data: profile } = await supabase
            .from('perfil')
            .select('rol, activo')
            .eq('id', session.user.id)
            .maybeSingle();

          if (profile && (!profile.activo || !['ADMIN', 'SUPERADMIN'].includes(profile.rol))) {
            document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
            window.location.replace('/login?error=unauthorized');
          }
        } catch (e) {}
      }
      verifyAdminAuth();

      // 2. Ajuste de padding según sidebar
      const wrapper = document.getElementById('admin-main-wrapper');
      if (wrapper) {
        const isCollapsed = localStorage.getItem('zairen_admin_sidebar_collapsed') === 'true';
        if (isCollapsed) {
          wrapper.classList.remove('md:pl-64');
          wrapper.classList.add('md:pl-20');
        }

        window.addEventListener('sidebar-toggle', (e: any) => {
          if (e.detail?.isCollapsed) {
            wrapper.classList.remove('md:pl-64');
            wrapper.classList.add('md:pl-20');
          } else {
            wrapper.classList.remove('md:pl-20');
            wrapper.classList.add('md:pl-64');
          }
        });
      }

      // 3. Listener del botón de Tema en Admin
      const adminThemeBtn = document.getElementById('admin-theme-toggle');
      if (adminThemeBtn) {
        adminThemeBtn.addEventListener('click', () => {
          const isLight = document.documentElement.classList.contains('light');
          const next = isLight ? 'dark' : 'light';
          if (next === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          }
          localStorage.setItem('zairen_theme', next);
          window.dispatchEvent(new Event('theme-change'));
        });
      }
    </script>

    <style>
      :global(html.light) #theme-icon-light {
        display: none !important;
      }
      :global(html.light) #theme-icon-dark {
        display: inline-block !important;
      }
      :global(html.dark) #theme-icon-dark {
        display: none !important;
      }
      :global(html.dark) #theme-icon-light {
        display: inline-block !important;
      }
    </style>
  </body>
</html>
