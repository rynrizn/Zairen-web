---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { Toaster } from '../components/ui/Toaster';

interface Props {
  title?: string;
  activePath?: string;
}

const { title = 'Admin // ZAIREN LAB', activePath = 'panel' } = Astro.props;

const navItems = [
  { label: 'Vista Catálogo', path: '/admin/vista-catalogo', id: 'vista-catalogo' },
  { label: 'Panel', path: '/admin', id: 'panel' },
  { label: 'Pedidos', path: '/admin/pedidos', id: 'pedidos', badge: '3' },
  { label: 'Inventario', path: '/admin/inventario', id: 'inventario' },
  { label: 'Registrar Ventas', path: '/admin/ventas', id: 'registrar-ventas' },
  { label: 'Usuarios', path: '/admin/usuarios', id: 'usuarios' },
  { label: 'Clientes', path: '/admin/clientes', id: 'clientes' },
  { label: 'Interfaz Web', path: '/admin/interfaz-web', id: 'interfaz-web' },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..900;1,300..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#131313] text-[#e5e2e1] antialiased min-h-screen flex flex-col font-body selection:bg-[#dc143c] selection:text-white">
    <Toaster client:load />

    <!-- Header Fijo Unificado de Administración -->
    <header class="fixed top-0 left-0 right-0 z-50 py-2 px-4 md:px-12 pointer-events-none">
      <div class="h-16 w-full max-w-[1440px] mx-auto px-4 md:px-6 flex items-center justify-between rounded-full bg-[#201f1f]/85 backdrop-blur-xl shadow-[0_4px_24px_rgba(0,0,0,0.5)] border border-white/[0.07] pointer-events-auto">
        <!-- Logo de Marca -->
        <a href="/admin" class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#0e0e0e] border border-white/[0.08] flex items-center justify-center text-[#dc143c]">
            <svg class="w-4 h-4" viewBox="0 0 64 64" fill="none">
              <path d="M14 20H50M20 20V48M44 20V48M14 28H50M24 38H40" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-headline text-sm font-bold text-[#e5e2e1] tracking-tight leading-none uppercase">
              {siteConfig.name}
            </span>
            <span class="font-code text-[10px] text-[#ffb3b3] uppercase tracking-widest">
              ADMIN CORE // OS
            </span>
          </div>
        </a>

        <!-- Navegación Central -->
        <nav class="hidden xl:flex items-center gap-1 bg-[#0e0e0e]/60 p-1.5 rounded-full border border-white/[0.05]">
          {navItems.map((item) => {
            const isActive = activePath === item.id;
            return (
              <a
                href={item.path}
                class:list={[
                  'relative px-3 py-1.5 rounded-full font-code text-xs uppercase tracking-wider transition-all flex items-center gap-1.5',
                  isActive
                    ? 'bg-[#dc143c] text-white font-bold shadow-[0_0_12px_rgba(220,20,60,0.4)]'
                    : 'text-[#e6bdbc] hover:bg-[#2a2a2a] hover:text-[#e5e2e1]'
                ]}
              >
                <span>{item.label}</span>
                {item.badge && (
                  <span class:list={[
                    'px-1.5 py-0.2 text-[10px] font-code rounded-full font-bold',
                    isActive ? 'bg-white text-[#dc143c]' : 'bg-[#dc143c] text-white shadow-[0_0_8px_rgba(220,20,60,0.4)]'
                  ]}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>

        <!-- Acciones Rápidas (Usuario / Logout) -->
        <div class="flex items-center gap-3">
          <a
            href="/"
            target="_blank"
            title="Abrir tienda en nueva pestaña"
            class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#1c1b1b] hover:bg-[#2a2a2a] text-[#e6bdbc] hover:text-white text-xs font-mono border border-white/[0.05] transition-all"
          >
            <span>Ver Tienda</span>
            <span class="material-symbols-outlined text-sm">open_in_new</span>
          </a>

          <button
            id="admin-logout-btn"
            title="Cerrar sesión"
            class="w-9 h-9 rounded-full bg-[#1c1b1b] hover:bg-[#93000a] text-[#e6bdbc] hover:text-white flex items-center justify-center transition-colors border border-white/[0.05] cursor-pointer"
          >
            <span class="material-symbols-outlined text-[18px]">logout</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Área de Contenido Principal -->
    <main class="w-full flex-1 pt-24 pb-12">
      <slot />
    </main>

    <script>
      import { supabase } from '../lib/supabase';

      document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
        if (confirm('¿Deseas cerrar la sesión administrativa?')) {
          await supabase.auth.signOut();
          document.cookie = 'sb-access-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          document.cookie = 'sb-refresh-token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          window.location.href = '/login';
        }
      });
    </script>
  </body>
</html>
