# 1. SUPABASE (Obtenidos de tu panel de Supabase: Project Settings > API)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu_service_role_key_aqui

# 2. CLOUDINARY (Alojamiento y optimización WebP dinámica de fotos)
PUBLIC_CLOUDINARY_CLOUD_NAME=zairen-lab
PUBLIC_CLOUDINARY_UPLOAD_PRESET=zairen_uploads

# 3. CONTACTO Y VENTAS WHATSAPP
# Número en formato internacional sin el signo '+', ej: 59174522654
PUBLIC_WHATSAPP_NUMBER=59170000000
PUBLIC_WHATSAPP_DISPLAY=+591 70000000

# 4. REDES SOCIALES DINÁMICAS (Deja vacía la que no uses)
PUBLIC_INSTAGRAM_URL=https://instagram.com/zairenlab
PUBLIC_TIKTOK_URL=
PUBLIC_FACEBOOK_URL=

# 5. MONEDA Y ENVÍO (Bolivia por defecto: BOB / Bs)
PUBLIC_BRAND_NAME=ZAIREN LAB
PUBLIC_CURRENCY_CODE=BOB
PUBLIC_CURRENCY_SYMBOL=Bs
PUBLIC_FREE_SHIPPING_THRESHOLD=250
PUBLIC_EXPRESS_SHIPPING_COST=15

# 6. SITIO WEB
PUBLIC_SITE_URL=https://zairenlab.com
