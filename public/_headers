# Reglas de encabezados HTTP para Cloudflare Pages // Zairen Lab

# Archivos estáticos y chunks de Vite con hash único: inmutables y caché por 1 año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon y assets raíz
/favicon.ico
  Cache-Control: public, max-age=86400

# Rutas de autenticación y panel de administración: nunca cachear
/login
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/admin/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Endpoints de API dinámicos
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cabeceras de seguridad globales para HTML
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
